class Shaxs:
    __shaxs_c = 0
    def __init__(self, ism, familiya, email, tel):
        self.ism = ism
        self.familiya = familiya
        self.email = email
        self.__tel = tel
        Shaxs.__shaxs_c += 1
        
    def get_tel(self):
        return self.__tel
    
    def change_tel(self, tel):
        self.__tel = tel
        return self.__tel

    @classmethod
    def get_shaxs_c(cls):
            return cls.__shaxs_c
    

class Talaba(Shaxs):
    __talaba_c = 0
    def __init__(self, ism, familiya, email, tel, id):
        super().__init__(ism, familiya, email, tel)
        self.__id = id
        Talaba.__talaba_c += 1
        
    def get_id(self):
        return self.__id
    
    def change_id(self, id):
        self.__id = id
        return self.__id
    
    @classmethod
    def get_talaba_c(cls):
        return cls.__talaba_c

