def bahola(ismlar):
    baholar = {}
    while ismlar:
        ism = ismlar.pop()
        baho = int(input(f"{ism.title()} ning bahosini kiriting: "))
        baholar[ism] = baho
    return baholar
        
talabalar = ['hasan', 'husan', 'ali', 'vali']
# ismlar = talabalar[:]
print(bahola(talabalar[:]))
